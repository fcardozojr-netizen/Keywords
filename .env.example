# Segurança — defina uma senha forte e um segredo aleatório
ADMIN_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=gere-um-segredo-aleatorio-longo
COOKIE_SECURE=false

# Google Ads API — não compartilhe estes valores
GOOGLE_ADS_CUSTOMER_ID=0000000000
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Opcional: reservado para expansão de recursos de IA
OPENAI_API_KEY=
